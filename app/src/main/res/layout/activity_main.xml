<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

<LinearLayout
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="32dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:text="@string/title"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/hint_new_record_wipes"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.04"
        android:text="@string/timer_zero"
        android:textColor="@color/text_primary"
        android:textSize="54sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/status_idle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <ru.giga.dictaphone.WaveformView
        android:id="@+id/wave"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginTop="14dp" />

    <SeekBar
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:max="1000"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:progress="0"
        android:progressBackgroundTint="@color/track"
        android:progressTint="@color/accent"
        android:thumbTint="@color/accent"
        android:visibility="invisible" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="0.7" />

    <ImageButton
        android:id="@+id/action"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:background="@drawable/bg_action"
        android:backgroundTint="@color/record"
        android:contentDescription="@string/btn_record"
        android:padding="28dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mic"
        android:tint="@color/text_primary" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="0.6" />

    <LinearLayout
        android:id="@+id/secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="invisible">

        <Button
            android:id="@+id/new_record"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:drawableStart="@drawable/ic_mic_small"
            android:drawablePadding="6dp"
            android:drawableTint="@color/text_primary"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/btn_new_record"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill"
            android:drawableStart="@drawable/ic_save"
            android:drawablePadding="6dp"
            android:drawableTint="@color/text_primary"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/btn_save"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>

</ScrollView>
